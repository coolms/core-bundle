{
    "name": "coolms/core-bundle",
    "description": "Symfony bundle wiring for coolms/core: the module bundle base class, DI extension and compiler passes, install/secret console commands, config cache warmer and the platform's HTTP plumbing",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": [
        "coolms",
        "cms",
        "symfony",
        "bundle",
        "platform"
    ],
    "authors": [
        {
            "name": "Dmitry Popov"
        }
    ],
    "require": {
        "php": "^8.5",
        "ext-mbstring": "*",
        "api-platform/core": "^4.2",
        "coolms/core": "^1.0",
        "coolms/core-module": "^1.0",
        "coolms/dtmpl": "^1.0",
        "coolms/rql": "^1.0",
        "psr/clock": "^1.0",
        "psr/event-dispatcher": "^1.0",
        "psr/log": "^3.0",
        "symfony/config": "^8.0",
        "symfony/console": "^8.0",
        "symfony/dependency-injection": "^8.0",
        "symfony/event-dispatcher": "^8.0",
        "symfony/expression-language": "^8.0",
        "symfony/framework-bundle": "^8.0",
        "symfony/http-client-contracts": "^3.0",
        "symfony/http-foundation": "^8.0",
        "symfony/http-kernel": "^8.0",
        "symfony/security-bundle": "^8.0",
        "symfony/serializer": "^8.0",
        "symfony/service-contracts": "^3.0",
        "symfony/translation-contracts": "^3.4.2",
        "symfony/uid": "^8.0",
        "symfony/validator": "^8.0",
        "symfony/yaml": "^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "symfony/http-client": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "CoolMS\\CoreBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CoolMS\\CoreBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "symfony": {
            "id": "coolms/core-bundle",
            "allow-contrib": false
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
